# Application
APP_NAME="Stock Research Agent API"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Browser clients allowed to call the API. Use comma-separated origins.
CORS_ORIGINS=http://localhost:3000
# AI provider
# Supported starter value: openai
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=replace_with_a_tool_calling_model_id
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOOL_CALLS=5
AI_STORE_RESPONSES=false
# Market-data provider
# Start with mock. Change to upstox or kite after implementing that adapter.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_STATUS=mock
MARKET_EXCHANGE=NSE
MARKET_TIMEZONE=Asia/Kolkata
MARKET_DEFAULT_INTERVAL=1d
MARKET_DATA_CACHE_TTL_SECONDS=900
# Upstox - optional while MARKET_DATA_PROVIDER=mock
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/auth/upstox/callback
# Zerodha Kite - optional while MARKET_DATA_PROVIDER=mock
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# PostgreSQL
# Replace credentials before running outside local development.
DATABASE_URL=postgresql+asyncpg://stock_agent:stock_agent@localhost:5432/stock_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
# Authentication
# Generate a long random value; never use this example in a deployed environment.
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Rate limiting and request boundaries
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_REQUEST_CHARACTERS=2000
# Ingestion and scheduling
ENABLE_SCHEDULER=false
DAILY_PRICE_JOB_HOUR=18
DAILY_PRICE_JOB_MINUTE=0
# Optional error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Testing
TESTING=false
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_KEY=replace_with_your_huggingface_api_key
HUGGINGFACE_MODEL=openai/gpt-oss-120b
HUGGINGFACE_INFERENCE_PROVIDER=auto
AI_PROVIDER=groq

API_V1_PREFIX=/api/v1
